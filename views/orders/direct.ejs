<% layout("layouts/boilerplate") %>

<div class="container my-5">
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <h2 class="fw-bold mb-1 text-dark">Direct Checkout</h2>
            <p class="text-muted">Complete your purchase quickly for this item.</p>
        </div>
    </div>

    <div class="row g-4 justify-content-center">

        <!-- Single Item Summary -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-4 text-dark">
                        <i class="bi bi-bag-check me-2 text-primary"></i>Item Summary
                    </h4>

                    <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <% if (product.image && product.image.url) { %>
                                <img
                                    src="<%= product.image.url %>"
                                    class="rounded-3 border object-fit-cover shadow-sm"
                                    alt="<%= product.title %>"
                                    style="width: 70px; height: 70px;"
                                >
                            <% } %>

                            <div>
                                <h6 class="fw-bold mb-1 text-dark fs-6">
                                    <%= product.title %>
                                </h6>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted small fw-medium">
                                        $<%= product.price.toFixed(2) %>
                                    </span>
                                    <span class="text-muted">&times;</span>

                                    <!-- Quantity Pill Inline -->
                                    <div class="d-inline-flex align-items-center gap-2 border rounded-pill px-3 py-1 bg-light shadow-sm">
                                        <button type="button" class="btn btn-sm border-0 p-0 fw-bold text-dark" id="btn-decrease" onclick="updateQuantity(-1)">
                                            −
                                        </button>
                                        <span class="fw-bold px-2 small text-primary" id="quantity-display">1</span>
                                        <button type="button" class="btn btn-sm border-0 p-0 fw-bold text-dark" id="btn-increase" onclick="updateQuantity(1)">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <strong class="text-dark fs-5">
                            $<span id="item-subtotal"><%= product.price.toFixed(2) %></span>
                        </strong>
                    </div>

                    <div class="p-3 bg-light rounded-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-secondary">Total Amount</span>
                            <h3 class="fw-bold text-primary mb-0">
                                $<span id="grand-total"><%= product.price.toFixed(2) %></span>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer & Shipping Form -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-4 text-dark">
                        <i class="bi bi-truck me-2 text-primary"></i>Delivery Information
                    </h4>

                    <form method="POST" action="/orders/direct/<%= product._id %>">

                        <!-- Hidden input for Express POST -->
                        <input type="hidden" name="quantity" id="quantity-input" value="1">

                        <!-- Full Name -->
                        <div class="form-floating mb-3">
                            <input
                                type="text"
                                name="fullName"
                                id="fullName"
                                class="form-control rounded-3"
                                placeholder="John Doe"
                                required
                            >
                            <label for="fullName">Full Name</label>
                        </div>

                        <!-- Address -->
                        <div class="form-floating mb-3">
                            <textarea
                                name="address"
                                id="address"
                                class="form-control rounded-3"
                                placeholder="123 Street Name"
                                style="height: 100px;"
                                required
                            ></textarea>
                            <label for="address">Address</label>
                        </div>

                        <!-- City & Phone Row -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input
                                        type="text"
                                        name="city"
                                        id="city"
                                        class="form-control rounded-3"
                                        placeholder="New York"
                                        required
                                    >
                                    <label for="city">City</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input
                                        type="tel"
                                        name="phone"
                                        id="phone"
                                        class="form-control rounded-3"
                                        placeholder="+1 234 567 890"
                                        required
                                    >
                                    <label for="phone">Phone Number</label>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Method -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Payment Method
                            </label>

                            <!-- Cash on Delivery -->
                            <div class="form-check custom-radio-card border rounded-3 p-3 mb-2 transition-all">
                                <input
                                    class="form-check-input ms-0 me-3 mt-1"
                                    type="radio"
                                    name="paymentMethod"
                                    value="COD"
                                    id="cod"
                                    checked
                                >
                                <label class="form-check-label w-100 cursor-pointer" for="cod">
                                    <span class="fw-semibold d-block text-dark">💵 Cash on Delivery</span>
                                    <small class="text-muted">Pay with cash upon package delivery.</small>
                                </label>
                            </div>

                            <!-- Online Payment -->
                            <div class="form-check custom-radio-card border rounded-3 p-3 transition-all">
                                <input
                                    class="form-check-input ms-0 me-3 mt-1"
                                    type="radio"
                                    name="paymentMethod"
                                    value="Online"
                                    id="online"
                                >
                                <label class="form-check-label w-100 cursor-pointer" for="online">
                                    <span class="fw-semibold d-block text-dark">💳 Online Payment</span>
                                    <small class="text-muted">Safe and instant online payment.</small>
                                </label>
                            </div>
                        </div>

                        <!-- Place Order -->
                        <button
                            type="submit"
                            class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm py-3 mt-2"
                        >
                            Place Order <i class="bi bi-arrow-right ms-2"></i>
                        </button>

                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Quantity Control Script -->
<script>
    const unitPrice = parseFloat("<%= product.price %>");
    const maxStock = parseInt("<%= product.stock %>");
    let currentQuantity = 1;

    function updateQuantity(change) {
        const newQuantity = currentQuantity + change;

        if (newQuantity < 1) return;
        if (newQuantity > maxStock) {
            alert(`Only ${maxStock} items available in stock!`);
            return;
        }

        currentQuantity = newQuantity;
        const calculatedTotal = (unitPrice * currentQuantity).toFixed(2);

        document.getElementById("quantity-display").innerText = currentQuantity;
        document.getElementById("item-subtotal").innerText = calculatedTotal;
        document.getElementById("grand-total").innerText = calculatedTotal;
        document.getElementById("quantity-input").value = currentQuantity;
    }
</script>