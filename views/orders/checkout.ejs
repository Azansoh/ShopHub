<% layout("layouts/boilerplate") %>

<div class="container my-5">
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <h2 class="fw-bold mb-1 text-dark">Checkout</h2>
            <p class="text-muted">Review your items and complete your delivery details.</p>
        </div>
    </div>

    <div class="row g-4 justify-content-center">

        <!-- Order Items Summary -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <h4 class="fw-bold m-0 text-dark">
                            <i class="bi bi-bag-check me-2 text-primary"></i>Your Order
                        </h4>
                        <span class="badge bg-primary-subtle text-primary fw-semibold rounded-pill px-3 py-2">
                            <%= cartProducts.length %> <%= cartProducts.length === 1 ? 'Item' : 'Items' %>
                        </span>
                    </div>

                    <div class="order-items-list mb-4" style="max-height: 380px; overflow-y: auto;">
                        <% cartProducts.forEach(item => { %>
                            <div class="d-flex justify-content-between align-items-center border-bottom py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <% if (item.product.image && item.product.image.url) { %>
                                        <img
                                            src="<%= item.product.image.url %>"
                                            class="rounded-3 border object-fit-cover shadow-sm"
                                            alt="<%= item.product.title %>"
                                            style="width: 60px; height: 60px;"
                                        >
                                    <% } %>

                                    <div>
                                        <h6 class="fw-semibold mb-1 text-dark">
                                            <%= item.product.title %>
                                        </h6>
                                        <small class="text-muted fw-medium">
                                            $<%= item.product.price.toFixed(2) %> &times; <%= item.quantity %>
                                        </small>
                                    </div>
                                </div>

                                <strong class="text-dark fs-6">
                                    $<%= item.subtotal.toFixed(2) %>
                                </strong>
                            </div>
                        <% }) %>
                    </div>

                    <div class="p-3 bg-light rounded-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-secondary">Total Amount</span>
                            <h3 class="fw-bold text-primary mb-0">
                                $<%= total.toFixed(2) %>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer & Shipping Form -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-4 text-dark">
                        <i class="bi bi-truck me-2 text-primary"></i>Delivery Information
                    </h4>

                    <form method="POST" action="/orders" class="needs-validation" novalidate>

                        <!-- Full Name -->
                        <div class="form-floating mb-3">
                            <input
                                type="text"
                                name="fullName"
                                id="fullName"
                                class="form-control rounded-3"
                                placeholder="John Doe"
                                required
                            >
                            <label for="fullName">Full Name</label>
                        </div>

                        <!-- Address -->
                        <div class="form-floating mb-3">
                            <textarea
                                name="address"
                                id="address"
                                class="form-control rounded-3"
                                placeholder="123 Street Name"
                                style="height: 100px;"
                                required
                            ></textarea>
                            <label for="address">Address</label>
                        </div>

                        <!-- City & Phone Row -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input
                                        type="text"
                                        name="city"
                                        id="city"
                                        class="form-control rounded-3"
                                        placeholder="New York"
                                        required
                                    >
                                    <label for="city">City</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input
                                        type="tel"
                                        name="phone"
                                        id="phone"
                                        class="form-control rounded-3"
                                        placeholder="+1 234 567 890"
                                        required
                                    >
                                    <label for="phone">Phone Number</label>
                                </div>
                            </div>
                        </div>

                        <!-- Payment Method -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark mb-2">
                                Payment Method
                            </label>

                            <!-- Cash on Delivery -->
                            <div class="form-check custom-radio-card border rounded-3 p-3 mb-2 transition-all">
                                <input
                                    class="form-check-input ms-0 me-3 mt-1"
                                    type="radio"
                                    name="paymentMethod"
                                    value="COD"
                                    id="cod"
                                    checked
                                >
                                <label class="form-check-label w-100 cursor-pointer" for="cod">
                                    <span class="fw-semibold d-block text-dark">💵 Cash on Delivery</span>
                                    <small class="text-muted">Pay with cash upon package delivery.</small>
                                </label>
                            </div>

                            <!-- Online Payment -->
                            <div class="form-check custom-radio-card border rounded-3 p-3 transition-all">
                                <input
                                    class="form-check-input ms-0 me-3 mt-1"
                                    type="radio"
                                    name="paymentMethod"
                                    value="Online"
                                    id="online"
                                >
                                <label class="form-check-label w-100 cursor-pointer" for="online">
                                    <span class="fw-semibold d-block text-dark">💳 Online Payment</span>
                                    <small class="text-muted">Safe and instant online payment.</small>
                                </label>
                            </div>
                        </div>

                        <!-- Place Order -->
                        <button
                            type="submit"
                            class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm py-3 mt-2"
                        >
                            Place Order <i class="bi bi-arrow-right ms-2"></i>
                        </button>

                    </form>
                </div>
            </div>
        </div>

    </div>
</div>