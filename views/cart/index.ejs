<% layout("layouts/boilerplate") %>

<div class="container my-5">
    
    <!-- Page Header -->
    <div class="mb-4 pb-2 border-bottom">
        <h2 class="fw-bold mb-1">Shopping Cart</h2>
        <p class="text-muted mb-0">Review items in your cart before proceeding to checkout.</p>
    </div>

    <% if (!cartProducts || cartProducts.length === 0) { %>

        <!-- Empty Cart State -->
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 bg-body-tertiary my-4">
            <div class="card-body py-4">
                <div class="display-1 text-muted mb-3">🛒</div>
                <h3 class="fw-bold text-dark">Your cart is empty</h3>
                <p class="text-muted mb-4 max-w-md mx-auto">
                    Looks like you haven't added anything to your cart yet.
                </p>
                <a href="/products" class="btn btn-primary rounded-pill px-4 py-2.5 fw-semibold shadow-sm">
                    Start Shopping
                </a>
            </div>
        </div>

    <% } else { %>

        <!-- Cart Grid Layout -->
        <div class="row g-4">
            
            <!-- Items List -->
            <div class="col-lg-8">
                <div class="d-flex flex-column gap-3">
                    <% cartProducts.forEach(item => { %>
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                            <div class="card-body p-3">
                                <div class="row align-items-center g-3">
                                    
                                    <!-- Product Image -->
                                    <div class="col-3 col-md-2">
                                        <div class="rounded-3 overflow-hidden bg-light" style="aspect-ratio: 1/1;">
                                            <% 
                                                let imgSrc = "https://images.unsplash.com/photo-1505740420928-5e560c06d30e";
                                                if (item.product) {
                                                    if (item.product.images && item.product.images.length > 0 && item.product.images[0].url) {
                                                        imgSrc = item.product.images[0].url;
                                                    } else if (item.product.image && item.product.image.url) {
                                                        imgSrc = item.product.image.url;
                                                    } else if (typeof item.product.image === 'string') {
                                                        imgSrc = item.product.image;
                                                    }
                                                }
                                            %>
                                            <img src="<%= imgSrc %>" class="w-100 h-100 object-fit-cover" alt="<%= item.product ? item.product.title : 'Product Image' %>">
                                        </div>
                                    </div>

                                    <!-- Details & Quantity Selector -->
                                    <div class="col-9 col-md-6">
                                        <h5 class="fw-bold text-dark mb-1 text-truncate">
                                            <a href="/products/<%= item.product._id %>" class="text-dark text-decoration-none">
                                                <%= item.product.title %>
                                            </a>
                                        </h5>
                                        <p class="text-muted small mb-2">
                                            Unit Price: <span class="fw-medium text-dark">Rs. <%= item.product.price ? item.product.price.toLocaleString() : '0' %></span>
                                        </p>
                                        
                                        <!-- Quantity Controls -->
                                        <div class="d-inline-flex align-items-center border rounded-pill bg-light p-1 shadow-sm">
                                            <form method="POST" action="/cart/decrease/<%= item.product._id %>" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-white rounded-circle fw-bold shadow-xs p-0 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" title="Decrease quantity">
                                                    −
                                                </button>
                                            </form>
                                            
                                            <span class="px-3 fw-bold small text-dark"><%= item.quantity %></span>
                                            
                                            <form method="POST" action="/cart/increase/<%= item.product._id %>" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-white rounded-circle fw-bold shadow-xs p-0 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;" title="Increase quantity">
                                                    +
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    <!-- Subtotal & Remove Button -->
                                    <div class="col-12 col-md-4 text-md-end d-flex d-md-block justify-content-between align-items-center pt-2 pt-md-0 border-top border-md-0">
                                        <div class="mb-md-2">
                                            <span class="text-muted small d-md-none">Subtotal: </span>
                                            <span class="fw-bold h5 mb-0 text-primary">
                                                Rs. <%= item.subtotal ? item.subtotal.toLocaleString() : '0' %>
                                            </span>
                                        </div>
                                        
                                        <form method="POST" action="/cart/remove/<%= item.product._id %>" class="d-inline">
                                            <button type="submit" class="btn btn-link text-danger text-decoration-none p-0 small fw-semibold hover-opacity">
                                                <i class="bi bi-trash me-1"></i>Remove
                                            </button>
                                        </form>
                                    </div>

                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
                
                <div class="mt-4">
                    <a href="/products" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                        ← Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 90px;">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">Order Summary</h4>
                        
                        <div class="d-flex justify-content-between mb-3 text-secondary">
                            <span>Subtotal</span>
                            <span class="fw-medium text-dark">Rs. <%= total ? total.toLocaleString() : '0' %></span>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-secondary">
                            <span>Estimated Shipping</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">Free</span>
                        </div>
                        
                        <hr class="my-4 border-secondary-subtle">
                        
                        <div class="d-flex justify-content-between align-items-baseline mb-4">
                            <span class="fw-bold h5 mb-0">Total</span>
                            <span class="fw-bold h3 mb-0 text-primary">
                                Rs. <%= total ? total.toLocaleString() : '0' %>
                            </span>
                        </div>
                        
                        <!-- Updated Checkout Action Link -->
                        <a href="/cart/checkout" class="btn btn-primary btn-lg w-100 rounded-pill fw-semibold shadow-sm py-3 d-flex align-items-center justify-content-center gap-2">
                            Proceed to Checkout
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

        </div>

    <% } %>

</div>

<style>
    .btn-white {
        background-color: #fff;
        border: 1px solid #dee2e6;
        color: #212529;
    }
    .btn-white:hover {
        background-color: #f8f9fa;
        border-color: #c1c9d0;
    }
    .shadow-xs {
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .hover-opacity:hover {
        opacity: 0.75;
    }
</style>