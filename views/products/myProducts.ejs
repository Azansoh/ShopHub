<% layout("layouts/boilerplate") %>

<div class="container py-5">
  <!-- Header Banner -->
  <div class="bg-primary bg-gradient text-white rounded-4 p-4 p-md-5 mb-5 shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
      <h1 class="fw-bold mb-1 display-6">My Inventory</h1>
      <p class="text-white-50 mb-0">Manage and keep track of your active marketplace listings.</p>
    </div>
    <a href="/products/new" class="btn btn-light btn-lg text-primary fw-bold shadow-sm rounded-3">
      + Add New Product
    </a>
  </div>

  <% if (myProducts && myProducts.length > 0) { %>
    <div class="row g-4">
      <% myProducts.forEach(product => { %>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
            
            <div class="position-relative">
              <% if (product.images && product.images.length > 0) { %>
                <img
                  src="<%= product.images[0].url %>"
                  class="card-img-top"
                  style="height: 220px; object-fit: cover;"
                  alt="<%= product.title %>"
                >
              <% } else { %>
                <img
                  src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e"
                  class="card-img-top"
                  style="height: 220px; object-fit: cover;"
                  alt="Product"
                >
              <% } %>

              <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 end-0 m-3 rounded-pill px-3 py-2">
                <%= product.category %>
              </span>
            </div>

            <div class="card-body d-flex flex-column p-4">
              <h5 class="card-title fw-bold text-truncate mb-2"><%= product.title %></h5>
              <h4 class="text-success fw-bold mb-3">$<%= Number(product.price).toLocaleString() %></h4>

              <div class="mb-4">
                <span class="text-muted small d-block mb-1">Stock Level</span>
                <% if (product.stock === 0) { %>
                  <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">Out of Stock</span>
                <% } else if (product.stock <= 5) { %>
                  <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill"><%= product.stock %> piece left</span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill"><%= product.stock %> piece available</span>
                <% } %>
              </div>

              <!-- Action Toolbar -->
              <div class="d-flex gap-2 mt-auto pt-3 border-top">
                <a href="/products/<%= product._id %>" class="btn btn-light border btn-sm flex-fill fw-semibold">View</a>
                <a href="/products/<%= product._id %>/edit" class="btn btn-outline-warning btn-sm flex-fill fw-semibold">Edit</a>
                <form method="POST" action="/products/<%= product._id %>?_method=DELETE" class="d-inline flex-fill" onsubmit="return confirm('Are you sure you want to delete this product?');">
                  <button class="btn btn-outline-danger btn-sm w-100 fw-semibold">Delete</button>
                </form>
              </div>

            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <!-- Empty Inventory View -->
    <div class="text-center py-5 my-4 bg-light rounded-4 border border-dashed">
      <div class="display-1 text-muted mb-3">📦</div>
      <h3 class="fw-bold">No Products Listed Yet</h3>
      <p class="text-muted mb-4">Start selling today by listing your first product onto the platform.</p>
      <a href="/products/new" class="btn btn-primary btn-lg px-4 fw-semibold rounded-3">
        Create Your First Listing
      </a>
    </div>
  <% } %>
</div>