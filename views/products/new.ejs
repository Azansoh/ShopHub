<% layout("layouts/boilerplate") %>

<style>
  .required-asterisk {
    color: #dc3545;
    font-weight: bold;
    margin-left: 2px;
  }
</style>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        
        <div class="card-header bg-success bg-gradient text-white text-center py-4">
          <h2 class="h3 mb-0 fw-bold">Create New Listing</h2>
          <p class="small text-white-50 mb-0">Fill all the Fields</p>
        </div>

        <div class="card-body p-4 p-md-5">
          <form id="productForm" method="POST" action="/products" enctype="multipart/form-data" class="needs-validation" novalidate>
            
            <!-- Title -->
            <div class="mb-4">
              <label for="title" class="form-label fw-semibold">
                Title <span class="required-asterisk">*</span>
              </label>
              <input 
                type="text" 
                id="title" 
                name="product[title]" 
                class="form-control form-control-lg fs-6" 
                placeholder="e.g., Sony WH-1000XM5 Headphones" 
                value="<%= typeof product !== 'undefined' && product.title ? product.title : '' %>"
                required 
              />
              <div class="invalid-feedback">Please enter a product title.</div>
            </div>

            <!-- Category -->
            <div class="mb-4">
              <label for="category" class="form-label fw-semibold">
                Category <span class="required-asterisk">*</span>
              </label>
              <select id="category" name="product[category]" class="form-select form-select-lg fs-6" required>
                <option value="" disabled <%= typeof product === 'undefined' || !product.category ? 'selected' : '' %>>Select a Category</option>
                <% 
                  const categories = [
                    "Electronics", "Clothing", "Footwear", "Beauty & Personal Care", 
                    "Books", "Home & Kitchen", "Sports & Fitness", "Toys & Games", 
                    "Automotive", "Groceries"
                  ]; 
                %>
                <% categories.forEach(cat => { %>
                  <option 
                    value="<%= cat %>" 
                    <%= (typeof product !== 'undefined' && product.category === cat) ? 'selected' : '' %>
                  >
                    <%= cat %>
                  </option>
                <% }) %>
              </select>
              <div class="invalid-feedback">Please select a category.</div>
            </div>

            <!-- Description -->
            <div class="mb-4">
              <label for="description" class="form-label fw-semibold">
                Description <span class="required-asterisk">*</span>
              </label>
              <textarea 
                id="description" 
                name="product[description]" 
                class="form-control" 
                rows="4" 
                placeholder="Provide a detailed description of the item..." 
                required
              ><%= typeof product !== 'undefined' && product.description ? product.description : '' %></textarea>
              <div class="form-text d-flex justify-content-between mt-1">
                <span>Minimum 15 words required.</span>
                <span id="wordCountText" class="text-muted">Word count: 0</span>
              </div>
              <div class="invalid-feedback" id="descriptionFeedback">Please enter a description with at least 15 words.</div>
            </div>

            <!-- Product Images -->
            <div class="mb-4">
              <label for="images" class="form-label fw-semibold">
                Product Gallery Images <span class="required-asterisk">*</span>
              </label>
              <input 
                type="file" 
                id="images" 
                name="images" 
                class="form-control" 
                accept="image/*" 
                multiple 
                required 
              />
              <div class="form-text">Select 3 to 10 photos to highlight your item.</div>
              <div class="invalid-feedback" id="imageFeedback">Please upload between 3 and 10 images.</div>
            </div>

            <!-- Price and Stock -->
            <div class="row">
              <div class="col-md-6 mb-4">
                <label for="price" class="form-label fw-semibold">
                  Price ($) <span class="required-asterisk">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text">$</span>
                  <input 
                    type="number" 
                    id="price" 
                    name="product[price]" 
                    class="form-control" 
                    min="0" 
                    step="0.01" 
                    placeholder="0.00" 
                    value="<%= typeof product !== 'undefined' && product.price ? product.price : '' %>"
                    required 
                  />
                </div>
                <div class="invalid-feedback">Please enter a valid price.</div>
              </div>
              
              <div class="col-md-6 mb-4">
                <label for="stock" class="form-label fw-semibold">
                  Stock Units <span class="required-asterisk">*</span>
                </label>
                <input 
                  type="number" 
                  id="stock" 
                  name="product[stock]" 
                  class="form-control" 
                  min="0" 
                  placeholder="0" 
                  value="<%= typeof product !== 'undefined' && product.stock ? product.stock : '' %>"
                  required 
                />
                <div class="invalid-feedback">Please enter available stock quantity.</div>
              </div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold py-3 shadow-sm rounded-3">Publish Product</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById("productForm");
  const imageInput = document.getElementById("images");
  const descriptionInput = document.getElementById("description");
  const wordCountText = document.getElementById("wordCountText");

  // Word Count Calculator Function
  function getWordCount(text) {
    return text.trim().split(/\s+/).filter(word => word.length > 0).length;
  }

  function updateWordCount() {
    const count = getWordCount(descriptionInput.value);
    wordCountText.innerText = `Word count: ${count}`;

    if (count < 15) {
      descriptionInput.setCustomValidity("Description must contain at least 15 words.");
      if (count > 0) {
        wordCountText.classList.add("text-danger");
        wordCountText.classList.remove("text-muted", "text-success");
      }
    } else {
      descriptionInput.setCustomValidity("");
      wordCountText.classList.remove("text-danger", "text-muted");
      wordCountText.classList.add("text-success");
    }
  }

  // Live checks
  descriptionInput.addEventListener("input", updateWordCount);

  imageInput.addEventListener("change", function () {
    if (this.files.length < 3) {
      this.setCustomValidity("You must upload at least 3 images.");
    } else if (this.files.length > 10) {
      this.setCustomValidity("You can upload a maximum of 10 images.");
    } else {
      this.setCustomValidity("");
    }
  });

  // Stop Form Submission if inputs are invalid (Prevents resetting images!)
  form.addEventListener("submit", function (event) {
    updateWordCount(); // Check description word count before submitting

    const count = getWordCount(descriptionInput.value);
    const fileCount = imageInput.files.length;

    if (!form.checkValidity() || count < 15 || fileCount < 3 || fileCount > 10) {
      event.preventDefault();
      event.stopPropagation();
      form.classList.add("was-validated");
    }
  });

  window.addEventListener("DOMContentLoaded", updateWordCount);
</script>