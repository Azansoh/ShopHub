<% layout("layouts/boilerplate") %>

<style>
  .product-page {
    padding-top: 30px;
    padding-bottom: 50px;
  }

  /* PRODUCT SECTION */
  .product-image-wrapper {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  }

  .product-image-wrapper img {
    width: 100%;
    height: 500px;
    object-fit: cover;
  }

  .product-info {
    padding: 10px 10px 10px 25px;
  }

  .product-title {
    font-size: 2rem;
    font-weight: 700;
    color: #172033;
    margin-bottom: 12px;
  }

  .rating-summary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #fff8e1;
    padding: 8px 14px;
    border-radius: 10px;
    margin-bottom: 15px;
  }

  .rating-summary .rating-number {
    color: #f5a900;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .rating-summary .review-count {
    color: #6c757d;
    font-size: 0.95rem;
  }

  .product-price {
    color: #198754;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 15px;
  }

  .product-description {
    color: #555;
    line-height: 1.7;
    margin-bottom: 18px;
  }

  .product-meta {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 20px;
  }

  .product-meta p {
    margin-bottom: 8px;
    color: #555;
  }

  .product-meta p:last-child {
    margin-bottom: 0;
  }

  .product-meta strong {
    color: #212529;
  }

  /* BUTTONS */
  .product-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .product-actions form {
    margin: 0;
  }

  .btn-shop-buy {
    background: #2bbced;
    border: none;
    color: white;
    font-weight: 600;
    border-radius: 10px;
    padding: 12px;
    transition: 0.2s ease;
  }

  .btn-shop-buy:hover {
    background: #20a9d8;
    color: white;
    transform: translateY(-1px);
  }

  .btn-shop-cart {
    background: #f26e21;
    border: none;
    color: white;
    font-weight: 600;
    border-radius: 10px;
    padding: 12px;
    transition: 0.2s ease;
  }

  .btn-shop-cart:hover {
    background: #df5e15;
    color: white;
    transform: translateY(-1px);
  }

  .wishlist-button {
    grid-column: 1 / -1;
  }

  .wishlist-button button {
    border-radius: 10px;
    padding: 11px;
    font-weight: 600;
    transition: 0.2s ease;
  }

  .wishlist-button button:hover {
    transform: translateY(-1px);
  }

  .owner-actions {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid #e5e5e5;
  }

  /* REVIEWS SECTION */
  .reviews-section {
    margin-top: 50px;
  }

  .reviews-heading {
    font-size: 2rem;
    font-weight: 700;
    color: #172033;
    margin-bottom: 25px;
  }

  .review-card {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    transition: 0.2s ease;
  }

  .review-card:hover {
    box-shadow: 0 7px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .review-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .review-stars {
    color: #ffb400;
    font-size: 1.25rem;
    letter-spacing: 2px;
  }

  .review-date {
    color: #888;
    font-size: 0.85rem;
  }

  .review-author {
    color: #555;
    font-size: 0.9rem;
    margin-bottom: 12px;
  }

  .review-author strong {
    color: #172033;
  }

  .review-comment {
    color: #333;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* REVIEW FORM */
  .review-form-card {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 14px;
    padding: 25px;
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.06);
    position: sticky;
    top: 20px;
  }

  .review-form-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #172033;
    margin-bottom: 20px;
  }

  .review-form-card label {
    font-weight: 600;
    color: #333;
    margin-bottom: 7px;
  }

  .review-form-card .form-select,
  .review-form-card .form-control {
    border-radius: 9px;
    border: 1px solid #dfe3e7;
    padding: 11px 12px;
  }

  .review-form-card .form-select:focus,
  .review-form-card .form-control:focus {
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.12);
  }

  .submit-review-btn {
    border-radius: 9px;
    padding: 11px;
    font-weight: 600;
  }

  /* VERIFIED / LOGIN BOXES */
  .verified-box {
    background: #fff8d8;
    border: 1px solid #ffe69c;
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  }

  .verified-box h6 {
    color: #735c00;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .verified-box p {
    color: #665f43;
    margin: 0;
    line-height: 1.5;
  }

  .login-review-box {
    background: #eef7ff;
    border: 1px solid #cfe8ff;
    border-radius: 14px;
    padding: 22px;
  }

  .empty-reviews {
    background: #f8f9fa;
    border: 1px dashed #ced4da;
    border-radius: 14px;
    padding: 35px 20px;
    text-align: center;
    color: #777;
  }

  .empty-reviews .empty-icon {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  .empty-reviews h5 {
    color: #343a40;
    font-weight: 600;
  }

  /* RECOMMENDATIONS */
  .recommendations-section {
    margin-top: 30px;
    margin-bottom: 30px;
  }

  .recommendations-heading {
    font-size: 2rem;
    font-weight: 700;
    color: #172033;
    margin-bottom: 6px;
  }

  .recommendations-subtitle {
    color: #777;
    margin-bottom: 25px;
  }

  .recommendation-card {
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    transition: 0.2s ease;
  }

  .recommendation-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.1);
  }

  .recommendation-image {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .recommendation-body {
    padding: 18px;
  }

  .recommendation-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #172033;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 50px;
  }

  .recommendation-category {
    color: #777;
    font-size: 0.9rem;
    margin-bottom: 8px;
  }

  .recommendation-price {
    color: #198754;
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 15px;
  }

  /* MODERN DELETE MODAL STYLES */
  .modal-custom-delete .modal-content {
    border: none;
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.18);
    padding: 32px 24px 28px 24px;
  }

  .modal-custom-delete .delete-icon-circle {
    width: 64px;
    height: 64px;
    background-color: #fef2f2;
    color: #ef4444;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px auto;
  }

  .modal-custom-delete .delete-icon-circle svg {
    width: 30px;
    height: 30px;
    stroke: #ef4444;
  }

  .modal-custom-delete .modal-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #111827;
    letter-spacing: -0.02em;
  }

  .modal-custom-delete .modal-description {
    color: #6b7280;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-top: 8px;
  }

  .modal-custom-delete .btn-cancel {
    background-color: #f3f4f6;
    color: #374151;
    font-weight: 600;
    border-radius: 12px;
    padding: 12px 20px;
    border: none;
    transition: all 0.2s ease;
  }

  .modal-custom-delete .btn-cancel:hover {
    background-color: #e5e7eb;
    color: #111827;
  }

  .modal-custom-delete .btn-confirm-delete {
    background-color: #ef4444;
    color: #ffffff;
    font-weight: 600;
    border-radius: 12px;
    padding: 12px 20px;
    border: none;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
    transition: all 0.2s ease;
  }

  .modal-custom-delete .btn-confirm-delete:hover {
    background-color: #dc2626;
    box-shadow: 0 6px 16px rgba(239, 68, 68, 0.35);
    transform: translateY(-1px);
  }

  /* RESPONSIVE */
  @media (max-width: 767px) {
    .product-page {
      padding-top: 15px;
    }

    .product-image-wrapper img {
      height: 350px;
    }

    .product-info {
      padding: 20px 5px;
    }

    .product-title {
      font-size: 1.6rem;
    }

    .product-actions {
      grid-template-columns: 1fr;
    }

    .wishlist-button {
      grid-column: auto;
    }

    .reviews-heading {
      font-size: 1.6rem;
    }

    .review-form-card {
      position: static;
    }

    .review-top {
      align-items: flex-start;
      gap: 10px;
      flex-direction: column;
    }
  }
</style>

<div class="container product-page">

  <!-- =========================
       PRODUCT SECTION
  ========================= -->
  <div class="row g-5 align-items-start">

    <!-- Image / Carousel -->
    <div class="col-md-6">
      <div class="product-image-wrapper position-relative">
        <% if (product.images && product.images.length > 1) { %>
          <div id="productCarousel" class="carousel slide" data-bs-ride="false">
            
            <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-3 z-3 px-3 py-2 fs-6 rounded-pill">
              <span id="activeImageNum">1</span> / <%= product.images.length %>
            </span>

            <div class="carousel-inner">
              <% product.images.forEach((img, index) => { %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                  <img src="<%= img.url %>" alt="<%= product.title %>">
                </div>
              <% }) %>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon p-3 bg-dark bg-opacity-50 rounded-circle" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon p-3 bg-dark bg-opacity-50 rounded-circle" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
        <% } else if (product.images && product.images.length === 1) { %>
          <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-3 z-3 px-3 py-2 fs-6 rounded-pill">
            1 / 1
          </span>
          <img src="<%= product.images[0].url %>" alt="<%= product.title %>">
        <% } else { %>
          <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-3 z-3 px-3 py-2 fs-6 rounded-pill">
            1 / 1
          </span>
          <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e" alt="Default Product Image">
        <% } %>
      </div>
    </div>

    <!-- Info -->
    <div class="col-md-6">
      <div class="product-info">

        <h1 class="product-title"><%= product.title %></h1>

        <!-- Rating -->
        <div class="rating-summary">
          <span class="rating-number">
            ★ <%= avgRating > 0 ? avgRating : "No ratings" %>
          </span>
          <span class="review-count">
            (<%= product.reviews ? product.reviews.length : 0 %> 
             <%= product.reviews && product.reviews.length === 1 ? "review" : "reviews" %>)
          </span>
        </div>

        <!-- Price -->
        <div class="product-price">$<%= product.price %></div>

        <!-- Description -->
        <p class="product-description"><%= product.description %></p>

        <!-- Meta -->
        <div class="product-meta">
          <p>Category: <strong><%= product.category %></strong></p>
          <p>Stock: <strong><%= product.stock %></strong></p>
          <% if (product.owner) { %>
            <p>Owned by: <strong><%= product.owner.username %></strong></p>
          <% } %>
        </div>

        <!-- User Actions -->
        <div class="product-actions">
          <form method="POST" action="/checkout/direct/<%= product._id %>">
            <button type="submit" class="btn btn-shop-buy w-100">Buy Now</button>
          </form>

          <form method="POST" action="/cart/add/<%= product._id %>">
            <button type="submit" class="btn btn-shop-cart w-100">Add to Cart</button>
          </form>

          <% if (currentUser) { %>
            <div class="wishlist-button">
              <form method="POST" action="/products/<%= product._id %>/wishlist">
                <button type="submit" class="btn btn-outline-danger w-100">
                  ❤️ Add to Wishlist
                </button>
              </form>
            </div>
          <% } %>
        </div>

        <!-- Owner Actions -->
        <% if (currentUser && product.owner && product.owner._id.equals(currentUser._id)) { %>
          <div class="owner-actions">
            <a href="/products/<%= product._id %>/edit" class="btn btn-warning me-2">Edit Product</a>
            
            <!-- TRIGGER MODAL FOR PRODUCT DELETE -->
            <form id="deleteProductForm" action="/products/<%= product._id %>?_method=DELETE" method="POST" class="d-inline">
              <button type="button" class="btn btn-danger" onclick="confirmDelete('deleteProductForm', 'Product')">Delete Product</button>
            </form>
          </div>
        <% } %>

      </div>
    </div>
  </div>

  <!-- =========================
        REVIEWS SECTION
  ========================= -->
  <div class="reviews-section">
    <hr class="mb-5">

    <h2 class="reviews-heading">Customer Reviews</h2>

    <div class="row g-4 align-items-start">

      <!-- Review List -->
      <div class="col-md-7">
        <% if (product.reviews && product.reviews.length > 0) { %>
          <div class="d-flex flex-column gap-3">
            <% for (let review of product.reviews) { %>
              <div class="review-card">
                <div class="review-top">
                  <div class="review-stars">
                    <% for(let i = 1; i <= 5; i++) { %>
                      <%= i <= review.rating ? "★" : "☆" %>
                    <% } %>
                  </div>

                  <div class="review-date">
                    <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "" %>
                  </div>
                </div>

                <div class="review-author">
                  By: <strong><%= review.author ? review.author.username : "Anonymous" %></strong>
                </div>

                <p class="review-comment"><%= review.comment %></p>

                <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                  <div class="mt-3">
                    <a href="/products/<%= product._id %>/reviews/<%= review._id %>/edit" class="btn btn-sm btn-outline-warning me-2">Edit</a>
                    
                    <!-- TRIGGER MODAL FOR REVIEW DELETE -->
                    <form id="deleteReviewForm-<%= review._id %>" action="/products/<%= product._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="d-inline">
                      <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDelete('deleteReviewForm-<%= review._id %>', 'Review')">Delete</button>
                    </form>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="empty-reviews">
            <div class="empty-icon">⭐</div>
            <h5>No reviews yet</h5>
            <p class="mb-0">Be the first customer to review this product.</p>
          </div>
        <% } %>
      </div>

      <!-- Review Form Box -->
      <div class="col-md-5">
        <% if (currentUser) { %>
          <% if (hasPurchased) { %>
            <div class="review-form-card">
              <h4 class="review-form-title">Write a Review</h4>
              <form action="/products/<%= product._id %>/reviews" method="POST">
                
                <div class="mb-3">
                  <label for="rating" class="form-label">Rating</label>
                  <select name="review[rating]" id="rating" class="form-select" required>
                    <option value="" disabled selected>Select Rating</option>
                    <option value="5">⭐⭐⭐⭐⭐ — Excellent</option>
                    <option value="4">⭐⭐⭐⭐ — Very Good</option>
                    <option value="3">⭐⭐⭐ — Good</option>
                    <option value="2">⭐⭐ — Fair</option>
                    <option value="1">⭐ — Poor</option>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="comment" class="form-label">Comment</label>
                  <textarea name="review[comment]" id="comment" class="form-control" rows="5" placeholder="Share your experience..." required></textarea>
                </div>

                <button type="submit" class="btn btn-primary submit-review-btn w-100">
                  ⭐ Submit Review
                </button>
              </form>
            </div>
          <% } else { %>
            <div class="verified-box">
              <h6>⚠️ Verified Purchase Required</h6>
              <p>You can only review products you have purchased and received.</p>
            </div>
          <% } %>
        <% } else { %>
          <div class="login-review-box">
            <h6 class="fw-bold mb-2">Want to leave a review?</h6>
            <p class="mb-0">
              Please <a href="/login" class="alert-link fw-semibold">login</a> to write a review.
            </p>
          </div>
        <% } %>
      </div>

    </div>
  </div>

  <!-- =========================
        RECOMMENDATIONS
  ========================= -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
    <div class="recommendations-section">
      <hr class="my-5">

      <h2 class="recommendations-heading">You May Also Like</h2>
      <p class="recommendations-subtitle">More products from the same category</p>

      <div class="row g-4">
        <% relatedProducts.forEach((relatedProduct) => { %>
          <div class="col-12 col-sm-6 col-lg-3">
            <div class="recommendation-card h-100">
              <% if (relatedProduct.images && relatedProduct.images.length > 0) { %>
                <img src="<%= relatedProduct.images[0].url %>" class="recommendation-image" alt="<%= relatedProduct.title %>">
              <% } else { %>
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e" class="recommendation-image" alt="Default Product Image">
              <% } %>

              <div class="recommendation-body">
                <h5 class="recommendation-title"><%= relatedProduct.title %></h5>
                <p class="recommendation-category"><%= relatedProduct.category %></p>
                <div class="recommendation-price">$<%= relatedProduct.price %></div>
                <a href="/products/<%= relatedProduct._id %>" class="btn btn-primary w-100">View Product</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

</div>

<!-- =========================
     STYLED CONFIRMATION MODAL
========================= -->
<div class="modal fade modal-custom-delete" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm" style="max-width: 400px;">
    <div class="modal-content text-center">
      
      <!-- Icon -->
      <div class="delete-icon-circle">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
        </svg>
      </div>

      <!-- Content -->
      <h4 class="modal-title" id="deleteModalTitle">Delete Item?</h4>
      <p class="modal-description" id="deleteModalBody">Are you sure you want to delete this item? This action cannot be undone.</p>
      
      <!-- Actions -->
      <div class="d-flex justify-content-center gap-2 mt-4">
        <button type="button" class="btn btn-cancel flex-grow-1" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-confirm-delete flex-grow-1" id="confirmDeleteBtn">Delete</button>
      </div>

    </div>
  </div>
</div>

<!-- JavaScript to handle carousel & dynamic deletion -->
<script>
  let targetFormId = null;

  function confirmDelete(formId, itemType) {
    targetFormId = formId;
    
    // Customize text based on item being deleted
    document.getElementById('deleteModalTitle').innerText = `Delete ${itemType}?`;
    document.getElementById('deleteModalBody').innerText = `Are you sure you want to delete this ${itemType.toLowerCase()}? This action cannot be undone.`;

    // Show the modal via Bootstrap JS
    const deleteModalEl = document.getElementById('deleteConfirmModal');
    const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalEl);
    deleteModal.show();
  }

  document.addEventListener("DOMContentLoaded", function () {
    // Submit form upon modal confirmation
    const confirmBtn = document.getElementById('confirmDeleteBtn');
    
    if (confirmBtn) {
      confirmBtn.addEventListener('click', function () {
        if (targetFormId) {
          const formToSubmit = document.getElementById(targetFormId);
          if (formToSubmit) {
            formToSubmit.submit();
          }
        }
      });
    }

    // Carousel script
    const productCarousel = document.getElementById("productCarousel");
    const activeNumSpan = document.getElementById("activeImageNum");

    if (productCarousel && activeNumSpan) {
      productCarousel.addEventListener("slid.bs.carousel", function (event) {
        activeNumSpan.innerText = event.to + 1;
      });
    }
  });
</script>