<% layout("layouts/boilerplate") %>

<div class="container py-5">
  <!-- Header section -->
  <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
    <div>
      <h1 class="fw-bold display-6 mb-1">Recently Viewed</h1>
      <p class="text-muted mb-0">Items you have recently inspected during your session</p>
    </div>
    <span class="badge bg-primary rounded-pill px-3 py-2 fs-6">
      <%= recentlyViewedProducts ? recentlyViewedProducts.length : 0 %> Items
    </span>
  </div>

  <% if (recentlyViewedProducts && recentlyViewedProducts.length > 0) { %>
    <div class="row g-4">
      <% recentlyViewedProducts.forEach(product => { %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
            
            <!-- FIXED: Check for product.images array instead of product.image -->
            <% if (product.images && product.images.length > 0 && product.images[0].url) { %>
              <img
                src="<%= product.images[0].url %>"
                class="card-img-top"
                style="height: 220px; object-fit: cover;"
                alt="<%= product.title %>"
              >
            <% } else { %>
              <img
                src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e"
                class="card-img-top"
                style="height: 220px; object-fit: cover;"
                alt="Product"
              >
            <% } %>

            <div class="card-body d-flex flex-column p-4">
              <span class="badge bg-light text-dark border w-auto align-self-start mb-2"><%= product.category %></span>
              <h5 class="card-title fw-bold text-truncate mb-2"><%= product.title %></h5>
              <h4 class="text-success fw-bold mb-3">$<%= product.price %></h4>

              <a href="/products/<%= product._id %>" class="btn btn-outline-primary mt-auto rounded-3 fw-semibold">View Product</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <!-- Empty view -->
    <div class="text-center py-5 rounded-4 bg-light border border-dashed my-4">
      <div class="display-1 text-muted mb-3">👁️</div>
      <h3 class="fw-bold">No History Found</h3>
      <p class="text-muted mb-4">Products you view while browsing will appear here for easy access.</p>
      <a href="/products" class="btn btn-primary btn-lg px-4 fw-semibold rounded-3">Browse Products</a>
    </div>
  <% } %>
</div>