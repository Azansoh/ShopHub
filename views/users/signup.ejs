<% layout("layouts/boilerplate") %>

<div class="row mt-5 mb-5 justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">

            <!-- Flash Error Message Display -->
            <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- Heading -->
            <div class="text-center mb-4">
                <h2 class="fw-bold text-dark">Create Account</h2>
                <p class="text-muted small">Join us today by filling out your credentials</p>
            </div>

            <!-- Signup Form -->
            <form
                method="POST"
                action="/signup"
                class="needs-validation"
                novalidate
                autocomplete="off"
            >

                <!-- USERNAME -->
                <div class="mb-3">
                    <label for="username" class="form-label fw-medium">
                        Username
                    </label>
                    <input 
                        type="text" 
                        id="username"
                        name="username"
                        value="<%= typeof username !== 'undefined' ? username : '' %>"
                        class="form-control rounded-3"
                        required
                        minlength="3"
                        pattern="(?=.*[A-Z])[a-zA-Z0-9_]{3,}"
                        autocomplete="off"
                        placeholder="e.g. User123"
                    />
                    <div class="form-text text-muted small mt-1">
                        Must contain at least 1 uppercase letter and minimum 3 characters.
                    </div>
                    <div class="invalid-feedback">
                        Username must be at least 3 characters long and contain at least one uppercase letter (e.g., User123).
                    </div>
                </div>

                <!-- EMAIL -->
                <div class="mb-3">
                    <label for="email" class="form-label fw-medium">
                        Email Address
                    </label>
                    <input 
                        type="email" 
                        id="email"
                        name="email"
                        value="<%= typeof email !== 'undefined' ? email : '' %>"
                        class="form-control rounded-3"
                        required
                        autocomplete="off"
                        placeholder="name@example.com"
                    />
                    <div class="invalid-feedback">
                        Please enter a valid email address.
                    </div>
                </div>

                <!-- PASSWORD -->
                <div class="mb-3">
                    <label for="password" class="form-label fw-medium">
                        Password
                    </label>
                    
                    <!-- Input group with password toggle button -->
                    <div class="input-group has-validation">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control rounded-start-3"
                            required
                            minlength="6"
                            pattern="(?=.*[a-zA-Z])(?=.*\d)(?=.*[@$!%*?&#\-_])[^\s]{6,}"
                            autocomplete="new-password"
                            placeholder="password"
                        />
                        <button 
                            class="btn btn-outline-secondary rounded-end-3" 
                            type="button" 
                            id="togglePassword"
                            aria-label="Toggle password visibility"
                        >
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                        <div class="invalid-feedback">
                            Password does not meet all the required conditions below.
                        </div>
                    </div>

                    <!-- Password Requirements Checklist -->
                    <div class="mt-3 p-3 bg-body-tertiary rounded-3 border border-secondary-subtle">
                        <span class="d-block fw-semibold small text-secondary mb-2">
                            Password Requirements:
                        </span>

                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="pass-check-length" disabled>
                            <label class="form-check-label small text-secondary" for="pass-check-length">
                                At least 6 characters
                            </label>
                        </div>

                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="pass-check-letter" disabled>
                            <label class="form-check-label small text-secondary" for="pass-check-letter">
                                At least 1 letter (a-z, A-Z)
                            </label>
                        </div>

                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="pass-check-number" disabled>
                            <label class="form-check-label small text-secondary" for="pass-check-number">
                                At least 1 number (0-9)
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="pass-check-special" disabled>
                            <label class="form-check-label small text-secondary" for="pass-check-special">
                                At least 1 special character (@$!%*?&#-_)
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Signup Button -->
                <button
                    type="submit"
                    class="btn btn-success w-100 py-3 fw-semibold rounded-3 shadow-sm mb-3"
                >
                    Sign Up
                </button>
            </form>

            <!-- Divider -->
            <div class="d-flex align-items-center my-3">
                <hr class="flex-grow-1 text-muted" />
                <span class="px-3 text-muted fw-semibold small">OR</span>
                <hr class="flex-grow-1 text-muted" />
            </div>

            <!-- Google Sign-In -->
            <a
                href="/google"
                class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center rounded-3 shadow-sm border-secondary-subtle text-dark fw-medium"
            >
                <svg class="me-2" width="18" height="18" viewBox="0 0 18 18">
                    <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.874 2.684-6.616z"/>
                    <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z"/>
                    <path fill="#FBBC05" d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
                    <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
                </svg>
                Continue with Google
            </a>

        </div>
    </div>
</div>

<script>
  (() => {
    'use strict';

    const forms = document.querySelectorAll('.needs-validation');

    Array.from(forms).forEach((form) => {
      form.addEventListener('submit', (event) => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);

      const inputs = form.querySelectorAll('input');
      inputs.forEach(input => {
        input.addEventListener('blur', () => {
          form.classList.add('was-validated');
        });
      });
    });

    const passwordInput = document.getElementById('password');
    const checkLength = document.getElementById('pass-check-length');
    const checkLetter = document.getElementById('pass-check-letter');
    const checkNumber = document.getElementById('pass-check-number');
    const checkSpecial = document.getElementById('pass-check-special');

    if (passwordInput) {
      passwordInput.addEventListener('input', function () {
        const val = passwordInput.value;
        checkLength.checked = val.length >= 6;
        checkLetter.checked = /[a-zA-Z]/.test(val);
        checkNumber.checked = /\d/.test(val);
        checkSpecial.checked = /[@$!%*?&#\-_]/.test(val);
      });
    }

    const togglePasswordBtn = document.getElementById('togglePassword');
    const toggleIcon = document.getElementById('toggleIcon');

    if (togglePasswordBtn && passwordInput && toggleIcon) {
      togglePasswordBtn.addEventListener('click', () => {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        
        toggleIcon.classList.toggle('bi-eye');
        toggleIcon.classList.toggle('bi-eye-slash');
      });
    }
  })();
</script>